rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Voxora AI – Sri Venkateswara College of Engineering, Tirupati
    // Problem Statement ID: A4 | Team RESLOVIX
    
    match /complaints/{complaintId} {
      // 1. Prototype open read access so students can track their complaints
      allow read: if true;
      
      // 2. Allow any student or faculty member to lodge a new complaint
      allow create: if request.resource.data.id != null 
                    && request.resource.data.title != null 
                    && request.resource.data.category != null;
      
      // 3. Status updates: In prototype mode open; in production restrict to authenticated SVCE staff
      allow update: if true;
      
      // 4. Protect complaints audit trail against deletion
      allow delete: if false;
    }
  }
}
